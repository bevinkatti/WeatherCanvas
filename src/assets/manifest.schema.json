{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aesthetic Weather manifest",
  "type": "object",
  "properties": {
    "cities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["lat","lon","timezone","asset"],
        "properties": {
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "timezone": { "type": "string" },
          "landmark": { "type": "string" },
          "asset": { "type": "string" },
          "premium": { "type": "boolean" }
        }
      }
    }
  },
  "required": ["cities"]
}
